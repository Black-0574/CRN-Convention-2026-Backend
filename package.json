{
  "name": "crn-convention-2026-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Back-office (Payload CMS + SQLite) de la Convention CRN 2026 — gestion du contenu publié par site/ (lot L3). SQLite choisi pour tourner sur un hébergement mutualisé (Hostinger), sans serveur de base de données dédié.",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "payload generate:types && next build",
    "start": "next start -p 3001",
    "start:hostinger": "node server.js",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate-from-content": "payload run scripts/migrate-from-content.ts",
    "test:boutique": "vitest run --root src/boutique/domaine",
    "test:concurrence": "payload run scripts/test-concurrence.ts",
    "test:scan": "payload run scripts/test-scan.ts",
    "ajouter-articles": "payload run scripts/ajouter-articles.ts",
    "test:saspay": "payload run scripts/test-saspay.ts",
    "saspay:verifier": "payload run scripts/saspay-verifier.ts",
    "produits-test": "payload run scripts/produits-test.ts"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@payloadcms/db-sqlite": "3.45.0",
    "@payloadcms/next": "3.45.0",
    "@payloadcms/richtext-lexical": "3.45.0",
    "@payloadcms/translations": "3.45.0",
    "graphql": "16.9.0",
    "next": "15.5.28",
    "payload": "3.45.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "^5.7.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
