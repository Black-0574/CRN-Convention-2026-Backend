# Copier en .env (jamais commité) et renseigner de vraies valeurs avant de lancer le back-office.

# Base de données SQLite (fichier local, pas de serveur à part) :
# - Docker (docker-compose.yml) : laisser la valeur par défaut, le fichier vit dans le volume.
# - Hébergement mutualisé (Hostinger) : chemin absolu vers un fichier dans votre espace, ex.
#   file:/home/votre-compte/crn-convention.db — ce fichier doit être writable par l'app Node.
DATABASE_URI=file:./crn-convention.db

# Secret de signature des sessions Payload — chaîne aléatoire longue, jamais réutilisée ailleurs.
# Générer par ex. avec : openssl rand -base64 32
PAYLOAD_SECRET=change-me

# Origine du site public (pour les en-têtes CORS de l'API Payload et de /api/chat).
# En local : http://localhost:4321 — en production : https://www.crn-convention2026.events
SITE_URL=http://localhost:4321

# Agent d'accueil NASTY (/api/chat) — clé API Anthropic (console.anthropic.com). Sans cette clé,
# NASTY répond avec un message d'indisponibilité plutôt que de planter.
ANTHROPIC_API_KEY=
