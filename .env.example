# Copier en .env (jamais commité) et renseigner de vraies valeurs avant de lancer le back-office.

# Base de données SQLite (fichier local, pas de serveur à part) :
# - Docker (docker-compose.yml) : laisser la valeur par défaut, le fichier vit dans le volume.
# - Hostinger : chemin ABSOLU hors du dossier de l'application, ex.
#   file:/home/<compte>/domains/admin.crn-convention2026.events/crn-convention.db — chaque
#   déploiement reconstruit l'appli dans un nouveau dossier ; un chemin relatif repartirait d'une
#   base vide à chaque mise en ligne.
DATABASE_URI=file:./crn-convention.db

# Dossier des fichiers téléversés (photos). Même règle que DATABASE_URI sur Hostinger : chemin
# absolu hors du dossier de l'application, ex. /home/<compte>/domains/admin.crn-convention2026.events/media
# Par défaut : ./media (dossier relatif au lancement, monté en volume avec Docker).
MEDIA_DIR=

# Secret de signature des sessions Payload — chaîne aléatoire longue, jamais réutilisée ailleurs.
# Générer par ex. avec : openssl rand -base64 32
PAYLOAD_SECRET=change-me

# Origine du site public (pour les en-têtes CORS de l'API Payload et de /api/chat).
# En local : http://localhost:4321 — en production : https://www.crn-convention2026.events
# (la variante sans « www. » est autorisée automatiquement ; plusieurs origines : séparer par « , »)
SITE_URL=http://localhost:4321

# Republication automatique du site public après une modification dans l'admin (voir README,
# « Republication du site »). Jeton GitHub limité au dépôt suivi par Hostinger, droit Contents en
# écriture. Vides : rien n'est republié.
SITE_REBUILD_GITHUB_REPO=
SITE_REBUILD_GITHUB_TOKEN=

# Agent d'accueil NASTY (/api/chat) — clé API Anthropic (console.anthropic.com). Sans cette clé,
# NASTY répond avec un message d'indisponibilité plutôt que de planter.
ANTHROPIC_API_KEY=

# ——— Boutique de la Convention : billets et paiement ———
# Secrets des billets (QR signés) et des liens de téléchargement : 32 caractères au moins chacun,
# générés par ex. avec : openssl rand -base64 32. OBLIGATOIRES avant d'ouvrir les ventes.
BILLETS_SECRET=
LIENS_SECRET=
# Adresse publique du back-office (liens des billets et bandeau de l'e-mail).
# Production : https://admin.crn-convention2026.events
PUBLIC_SERVER_URL=http://localhost:3001

# Prestataire de paiement : saspay (production) ou bac-a-sable (local uniquement).
PAIEMENT_PRESTATAIRE=bac-a-sable
# SasPay (docs.saspay.me) — tableau de bord app.saspay.me, section Développeur. Clé secrète
# sk_test_… pour les essais, sk_live_… en production ; jamais dans le site ni dans Git.
SASPAY_API_KEY=
# Secret de signature du point de réception (Webhooks → URL
# https://admin.crn-convention2026.events/api/boutique/paiements/saspay/webhook, événements
# transaction.success, transaction.failed, transaction.cancelled). Affiché UNE seule fois.
SASPAY_WEBHOOK_SECRET=
# Facultatifs : pays présélectionné sur la page de paiement (défaut GA) ; qui paie les frais
# (DEDUCTED : le client paie le prix affiché, frais déduits du reversement ; ADD_ON : frais en sus
# pour le client). Vide : réglage du compte SasPay (Paramètres → Frais).
SASPAY_PAYS=GA
SASPAY_MODE_FRAIS=

# E-mails de la boutique aux clients (confirmation de commande, billets), expédiés depuis
# boutique@crn-convention2026.events (messagerie Hostinger du domaine). Sans ces trois variables,
# rien n'est envoyé : les e-mails sont écrits dans .courriels/ (développement local).
# Essai : npm run courriel:test -- destinataire@exemple.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=boutique@crn-convention2026.events
# Mot de passe de la boîte boutique@ (hPanel → Emails → Boîtes mail), jamais dans Git.
SMTP_PASS=
# Facultatif : nom et adresse d'expédition (défaut « Convention CRN 2026 <boutique@crn-convention2026.events> »).
COURRIEL_EXPEDITEUR=
