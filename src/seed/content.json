  "faq": [
    {
      "id": "comment-acheter-un-pass",
      "data": {
        "question": "Comment acheter un pass ou un billet ?",
        "reponse": "Sur la Boutique de la Convention, crn-convention2026.events/boutique, accessible depuis le bouton de la boutique en haut de chaque page du site. Choisissez votre pass ou votre ticket, renseignez le nom et les coordonnées de chaque titulaire, puis payez par Mobile Money ou par carte bancaire. Chaque pass et chaque billet est nominatif, avec un QR code unique émis dès le paiement et envoyé par e-mail ; il est scanné à l’entrée de chaque site auquel il donne accès. Les articles officiels (tee-shirt, pagne) et les kits des pass sont livrés dans l’église du réseau de votre choix, au Gabon ou hors du Gabon, ou, à titre exceptionnel, à domicile ou au lieu de travail à Libreville.",
        "etats": [
          "campagne",
          "evenement"
        ],
        "ordre": 1
      }
    },
    {
      "id": "diaspora-comment-suivre",
      "data": {
        "question": "Je suis dans la diaspora : comment suivre la Convention ?",
        "reponse": "Consultez la page Diaspora pour suivre la Convention à distance, donner en ligne et participer à la session dédiée du 19 décembre.",
        "etats": [
          "campagne",
          "evenement"
        ],
        "ordre": 6
      }
    },
    {
      "id": "horaires-et-lieux",
      "data": {
        "question": "Où se déroule la Convention et selon quels horaires ?",
        "reponse": "L’essentiel du programme se tient à l’Église Centrale, à Libreville, du 5 au 12 décembre. Le 13 décembre, la Convention se conclut au Nomad : culte unique de toutes les églises, ordination et Concert pour la vie. Consultez la page Programme pour le détail jour par jour.",
        "etats": [
          "campagne",
          "evenement"
        ],
        "ordre": 5
      }
    },
    {
      "id": "pass-perdu-ou-probleme",
      "data": {
        "question": "J’ai un problème avec mon pass ou mon paiement, qui contacter ?",
        "reponse": "Utilisez les coordonnées indiquées sur la page Contact. Conservez votre référence de transaction : elle facilite le traitement de votre demande.",
        "etats": [
          "campagne",
          "evenement"
        ],
        "ordre": 7
      }
    },
    {
      "id": "qr-code",
      "data": {
        "question": "Comment fonctionne le contrôle d’accès par QR code ?",
        "reponse": "Chaque ticket ou pass est nominatif et intransférable. Il porte un QR code unique, scanné à chaque entrée. Aucun accès verbal n’est accepté : présentez votre QR code, sur votre téléphone ou imprimé, à chaque séance.",
        "etats": [
          "campagne",
          "evenement"
        ],
        "ordre": 2
      }
    },
    {
      "id": "quels-moyens-de-paiement",
      "data": {
        "question": "Quels moyens de paiement sont acceptés ?",
        "reponse": "Sur la Boutique de la Convention, le paiement se fait par Mobile Money, auprès des opérateurs de plusieurs pays d’Afrique, ou par carte bancaire, sur la page sécurisée d’un prestataire de paiement agréé. La Page de la Convention ne conserve aucune donnée de paiement.",
        "etats": [
          "campagne",
          "evenement"
        ],
        "ordre": 3
      }
    },
    {
      "id": "site-accessible-sans-vpn",
      "data": {
        "question": "Ai-je besoin d’un VPN pour accéder à ce site ou suivre le direct ?",
        "reponse": "Non. Cette page est hébergée sur un domaine propre du CRN, sans dépendance à Facebook, YouTube, Instagram, TikTok ou WhatsApp. Elle s’affiche intégralement, et le direct se lit sans VPN, depuis le Gabon.",
        "etats": [
          "campagne",
          "evenement",
          "prolongement"
        ],
        "ordre": 4
      }
    }
  ],
